PROJECT_NAME="Jotirmoya Bhakta Sarker Portfolio API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Database configuration (defaults to SQLite; supports PostgreSQL: postgresql+psycopg2://user:password@localhost/dbname)
DATABASE_URL="sqlite:///./portfolio.db"

# CORS configuration (comma-separated list of origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001"

# Rate limiting
RATE_LIMIT_CONTACT="5/minute"

# Server configuration
HOST="127.0.0.1"
PORT=8000
